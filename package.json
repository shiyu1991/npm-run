{
  "name": "npm-run-manager",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.9.2",
  "publisher": "npm-run-dev",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shiyu1991/npm-run.git"
  },
  "bugs": {
    "url": "https://github.com/shiyu1991/npm-run/issues"
  },
  "homepage": "https://github.com/shiyu1991/npm-run#readme",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "npm",
    "scripts",
    "runner",
    "ports",
    "services",
    "process",
    "dev-server",
    "monorepo",
    "cursor",
    "windsurf",
    "trae",
    "codebuddy",
    "kiro"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "npm-run-container",
          "title": "%containerTitle%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "npm-run-container": [
        {
          "id": "npm-run.scripts",
          "name": "%viewName%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "npm-run.runScript",
        "title": "%cmd.runScript.title%",
        "icon": "$(play)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.stopScript",
        "title": "%cmd.stopScript.title%",
        "icon": "$(debug-stop)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.restartScript",
        "title": "%cmd.restartScript.title%",
        "icon": "$(debug-restart)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.restartService",
        "title": "%cmd.restartService.title%",
        "icon": "$(debug-restart)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.respawnUnsupported",
        "title": "%cmd.respawnUnsupported.title%",
        "icon": "$(circle-slash)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.showOutput",
        "title": "%cmd.showOutput.title%",
        "icon": "$(output)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.killService",
        "title": "%cmd.killService.title%",
        "icon": "$(close)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.killExternal",
        "title": "%cmd.killExternal.title%",
        "icon": "$(close)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.openInBrowser",
        "title": "%cmd.openInBrowser.title%",
        "icon": "$(link-external)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.refresh",
        "title": "%cmd.refresh.title%",
        "icon": "$(refresh)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.runGroup",
        "title": "%cmd.runGroup.title%",
        "icon": "$(play)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.addToGroup",
        "title": "%cmd.addToGroup.title%",
        "category": "npm-run"
      },
      {
        "command": "npm-run.removeFromGroup",
        "title": "%cmd.removeFromGroup.title%",
        "icon": "$(close)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.deleteGroup",
        "title": "%cmd.deleteGroup.title%",
        "category": "npm-run"
      },
      {
        "command": "npm-run.memberRestart",
        "title": "%cmd.memberRestart.title%",
        "icon": "$(debug-restart)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.newGroup",
        "title": "%cmd.newGroup.title%",
        "icon": "$(new-folder)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.stopGroup",
        "title": "%cmd.stopGroup.title%",
        "icon": "$(debug-stop)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.stopMember",
        "title": "%cmd.stopMember.title%",
        "icon": "$(debug-stop)",
        "category": "npm-run"
      },
      {
        "command": "npm-run.memberStart",
        "title": "%cmd.memberStart.title%",
        "icon": "$(play)",
        "category": "npm-run"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "npm-run.newGroup",
          "when": "view == npm-run.scripts",
          "group": "navigation"
        },
        {
          "command": "npm-run.refresh",
          "when": "view == npm-run.scripts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "npm-run.runScript",
          "when": "view == npm-run.scripts && viewItem == script",
          "group": "inline"
        },
        {
          "command": "npm-run.runScript",
          "when": "view == npm-run.scripts && viewItem == script-external",
          "group": "inline"
        },
        {
          "command": "npm-run.runScript",
          "when": "view == npm-run.scripts && viewItem == builtin",
          "group": "inline"
        },
        {
          "command": "npm-run.killExternal",
          "when": "view == npm-run.scripts && viewItem == script-external",
          "group": "inline"
        },
        {
          "command": "npm-run.stopScript",
          "when": "view == npm-run.scripts && viewItem == script-running",
          "group": "inline"
        },
        {
          "command": "npm-run.stopScript",
          "when": "view == npm-run.scripts && viewItem == builtin-running",
          "group": "inline"
        },
        {
          "command": "npm-run.restartScript",
          "when": "view == npm-run.scripts && viewItem == script-running",
          "group": "inline"
        },
        {
          "command": "npm-run.showOutput",
          "when": "view == npm-run.scripts && viewItem == script-running",
          "group": "inline"
        },
        {
          "command": "npm-run.showOutput",
          "when": "view == npm-run.scripts && viewItem == builtin-running",
          "group": "inline"
        },
        {
          "command": "npm-run.restartService",
          "when": "view == npm-run.scripts && viewItem == service",
          "group": "inline"
        },
        {
          "command": "npm-run.respawnUnsupported",
          "when": "view == npm-run.scripts && viewItem == service-norespawn",
          "group": "inline"
        },
        {
          "command": "npm-run.openInBrowser",
          "when": "view == npm-run.scripts && viewItem == service-norespawn",
          "group": "inline"
        },
        {
          "command": "npm-run.killService",
          "when": "view == npm-run.scripts && viewItem == service",
          "group": "inline"
        },
        {
          "command": "npm-run.restartScript",
          "when": "view == npm-run.scripts && viewItem == service-root",
          "group": "inline"
        },
        {
          "command": "npm-run.openInBrowser",
          "when": "view == npm-run.scripts && viewItem == script-running",
          "group": "inline"
        },
        {
          "command": "npm-run.openInBrowser",
          "when": "view == npm-run.scripts && viewItem == script-external",
          "group": "inline"
        },
        {
          "command": "npm-run.openInBrowser",
          "when": "view == npm-run.scripts && viewItem == service",
          "group": "inline"
        },
        {
          "command": "npm-run.openInBrowser",
          "when": "view == npm-run.scripts && viewItem == service-root",
          "group": "inline"
        },
        {
          "command": "npm-run.openInBrowser",
          "when": "view == npm-run.scripts && viewItem == external-port",
          "group": "inline"
        },
        {
          "command": "npm-run.runGroup",
          "when": "view == npm-run.scripts && viewItem == launch-group",
          "group": "inline"
        },
        {
          "command": "npm-run.runGroup",
          "when": "view == npm-run.scripts && viewItem == launch-group-running",
          "group": "inline"
        },
        {
          "command": "npm-run.stopGroup",
          "when": "view == npm-run.scripts && viewItem == launch-group-running",
          "group": "inline"
        },
        {
          "command": "npm-run.showOutput",
          "when": "view == npm-run.scripts && viewItem == launch-group-running",
          "group": "inline"
        },
        {
          "command": "npm-run.openInBrowser",
          "when": "view == npm-run.scripts && viewItem == launch-group-running",
          "group": "inline"
        },
        {
          "command": "npm-run.memberStart",
          "when": "view == npm-run.scripts && viewItem == group-member",
          "group": "inline"
        },
        {
          "command": "npm-run.removeFromGroup",
          "when": "view == npm-run.scripts && viewItem == group-member",
          "group": "inline"
        },
        {
          "command": "npm-run.memberRestart",
          "when": "view == npm-run.scripts && viewItem == group-member-running",
          "group": "inline"
        },
        {
          "command": "npm-run.stopMember",
          "when": "view == npm-run.scripts && viewItem == group-member-running",
          "group": "inline"
        },
        {
          "command": "npm-run.showOutput",
          "when": "view == npm-run.scripts && viewItem == group-member-running",
          "group": "inline"
        },
        {
          "command": "npm-run.openInBrowser",
          "when": "view == npm-run.scripts && viewItem == group-member-running",
          "group": "inline"
        },
        {
          "command": "npm-run.removeFromGroup",
          "when": "view == npm-run.scripts && viewItem == group-member-running",
          "group": "inline"
        },
        {
          "command": "npm-run.deleteGroup",
          "when": "view == npm-run.scripts && viewItem == launch-group"
        },
        {
          "command": "npm-run.deleteGroup",
          "when": "view == npm-run.scripts && viewItem == launch-group-running"
        },
        {
          "command": "npm-run.addToGroup",
          "when": "view == npm-run.scripts && viewItem == script"
        },
        {
          "command": "npm-run.addToGroup",
          "when": "view == npm-run.scripts && viewItem == script-running"
        }
      ]
    },
    "configuration": {
      "title": "npm-run",
      "properties": {
        "npm-run.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/.git/**",
            "**/coverage/**"
          ],
          "description": "%config.exclude.description%"
        },
        "npm-run.pollIntervalMs": {
          "type": "number",
          "default": 1500,
          "minimum": 500,
          "description": "%config.pollIntervalMs.description%"
        },
        "npm-run.env": {
          "type": "object",
          "default": {},
          "description": "%config.env.description%"
        },
        "npm-run.groups": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "%config.groups.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node esbuild.js --test && mocha out-test/**/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.21.5",
    "mocha": "^10.4.0",
    "typescript": "^5.4.5"
  }
}
